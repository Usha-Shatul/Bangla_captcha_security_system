# ============================================================
# Adaptive Bangla CAPTCHA — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Flask
SECRET_KEY=dev-secret-change-in-production
JWT_SECRET=jwt-secret-change-in-production
JWT_EXPIRY_HOURS=24
FLASK_DEBUG=1
PORT=5000

# MySQL 8.0+
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=ticketmonarch_db

# CORS
CORS_ORIGINS=http://localhost:3000

# Bot Detection
BOT_THRESHOLD=0.7

# RL Agent — Select algorithm: ppo | soft_ppo | dg
RL_ALGORITHM=ppo

# RL Checkpoints
RL_CHECKPOINT_DIR=./rl_captcha/checkpoints
CLASSIFIER_MODEL_DIR=./classifier/saved_models

# Dataset Paths
EASY_CAPTCHA_DATASET_DIR=../../datasets/easy
MEDIUM_CAPTCHA_DATASET_DIR=../../datasets/medium
